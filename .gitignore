# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/*
!/out/.gitkeep

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local dev store + capacitor build outputs
/data
/ios
/android

# App-Signing-Secrets — NIEMALS committen
*.keystore
*.jks
keystore.properties
*.mobileprovision
*.p12
/build-output
*.apk
*.aab
*.ipa

# prisma local sqlite
/prisma/dev.db
/prisma/dev.db-journal
/prisma/*.db-shm
/prisma/*.db-wal

# typescript
*.tsbuildinfo
next-env.d.ts

# Brainstorming sessions
.superpowers/
.claude/

# Electron build output (binaries too large for git)
/electron/dist/
/electron/node_modules/

# Android signing key (never commit — losing this breaks Play Store updates)
/android/mastermind.keystore
/android/keystore.properties

# App download binaries (deployed via scp, not git)
/downloads/*.exe
/downloads/*.dmg
/downloads/*.AppImage
/downloads/*.deb
/downloads/*.apk
