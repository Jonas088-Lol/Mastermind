// ── Web Push ───────────────────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Datei-Uploads ─────────────────────────────────────────

model FileUpload {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  size         Int
  path         String
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([assignmentId])
}

// ── Feature Flags ──────────────────────────────────────────

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  state       String   @default("off")
  rollout     Int      @default(0)
  scope       String   @default("alle")
  owner       String   @default("Plattform")
  metric      String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model ApiToken {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String    @default("read")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([schoolId])
}

// ── Arbeitsblätter ─────────────────────────────────────────

model Worksheet {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creatorId        String
  creator          User     @relation("CreatedWorksheets", fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id])
  gradeLevel       Int?
  difficulty       String   @default("mittel")
  estimatedMinutes Int      @default(15)
  status           String   @default("draft")
  isTemplate       Boolean  @default(false)
  language         String   @default("de")
  items            WorksheetItem[]
  assignments      WorksheetAssignment[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([schoolId])
  @@index([creatorId])
}

model WorksheetItem {
  id            String    @id @default(cuid())
  worksheetId   String
  worksheet     Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  type          String
  order         Int
  config        String
  correctAnswer String?
  hint          String?
  points        Int       @default(1)
  required      Boolean   @default(true)
  answers       WorksheetItemAnswer[]

  @@index([worksheetId])
}

model WorksheetAssignment {
  id           String       @id @default(cuid())
  worksheetId  String
  worksheet    Worksheet    @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  classId      String?
  class        SchoolClass? @relation(fields: [classId], references: [id])
  teacherId    String
  teacher      User         @relation("TeacherWorksheetAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt   DateTime     @default(now())
  dueAt        DateTime?
  maxAttempts  Int          @default(1)
  showHints    Boolean      @default(true)
  showSolution Boolean      @default(false)
  submissions  WorksheetSubmission[]

  @@index([worksheetId])
  @@index([classId])
}

model WorksheetSubmission {
  id           String              @id @default(cuid())
  assignmentId String
  assignment   WorksheetAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User                @relation("StudentWorksheetSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  startedAt    DateTime            @default(now())
  submittedAt  DateTime?
  score        Int?
  maxScore     Int?
  timeTakenSec Int?
  status       String              @default("in_progress")
  itemAnswers  WorksheetItemAnswer[]

  @@index([assignmentId])
  @@index([studentId])
}

model WorksheetItemAnswer {
  id           String              @id @default(cuid())
  submissionId String
  submission   WorksheetSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  itemId       String
  item         WorksheetItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  answer       String
  isCorrect    Boolean?
  pointsEarned Int?
  answeredAt   DateTime            @default(now())

  @@unique([submissionId, itemId])
  @@index([submissionId])
}

// ── Gamification ───────────────────────────────────────────

model Quest {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  lore        String?
  type        String
  category    String
  targetCount Int      @default(1)
  xpReward    Int      @default(50)
  titleReward String?
  icon        String   @default("⚔️")
  difficulty  String   @default("normal")
  rarity      String   @default("common")
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  userProgress UserQuest[]
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completedAt DateTime?
  claimedAt   DateTime?
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
}

model UserTitle {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleSlug  String
  unlockedAt DateTime @default(now())

  @@unique([userId, titleSlug])
  @@index([userId])
}

model DailyLoginReward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       Int
  xpAwarded Int
  claimedAt DateTime @default(now())

  @@index([userId])
}

model Season {
  id       String   @id @default(cuid())
  schoolId String?
  school   School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  number   Int
  theme    String?
  startAt  DateTime
  endAt    DateTime
  isActive Boolean  @default(false)

  passes         UserSeasonPass[]
  rankingEntries SeasonRankingEntry[]

  @@index([schoolId])
  @@index([isActive])
}

model UserSeasonPass {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  xpEarned Int    @default(0)
  tier     Int    @default(0)

  @@unique([userId, seasonId])
  @@index([userId])
}

model BossBattle {
  id               String   @id @default(cuid())
  schoolId         String?
  school           School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String
  description      String
  lore             String?
  subject          String?
  gradeLevel       Int?
  tier             String   @default("common")
  maxHp            Int      @default(20)
  currentHp        Int      @default(20)
  difficulty       String   @default("hard")
  coinReward       Int      @default(8)
  mvpCoinReward    Int      @default(25)
  xpReward         Int      @default(100)
  icon             String   @default("👹")
  startAt          DateTime
  endAt            DateTime
  isActive         Boolean  @default(false)
  firstBloodUserId String?
  killedByUserId   String?

  participants BossParticipant[]

  @@index([schoolId])
  @@index([isActive])
}

model BossParticipant {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleId       String
  battle         BossBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  damage         Int        @default(0)
  correctAnswers Int        @default(0)
  wrongAnswers   Int        @default(0)
  coinsEarned    Int        @default(0)
  isMvp          Boolean    @default(false)
  firstBlood     Boolean    @default(false)
  lastHit        Boolean    @default(false)
  joinedAt       DateTime   @default(now())

  @@unique([userId, battleId])
  @@index([userId])
  @@index([battleId])
  @@index([userId, damage])
  @@index([userId, isMvp])
}

model SkillNode {
  id          String  @id @default(cuid())
  subject     String
  slug        String
  title       String
  description String
  tier        Int     @default(1)
  requiredXp  Int     @default(0)
  icon        String  @default("⭐")
  color       String  @default("#6366f1")
  parentSlug  String?
  xpBonus     Int     @default(0)
  sortOrder   Int     @default(0)

  userNodes UserSkillNode[]

  @@unique([subject, slug])
}

model UserSkillNode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId     String
  node       SkillNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  unlockedAt DateTime  @default(now())

  @@unique([userId, nodeId])
  @@index([userId])
}

// New mega skill tree — replaces the old 4-tier system
model UserSkillMastery {
  id            String    @id @default(cuid())
  userId        String
  nodeSlug      String
  masteryTier   Int       @default(0)  // 0=locked,1=bronze,2=silber,3=gold
  exercisesDone Int       @default(0)  // cumulative correct answers for this node
  unlockedAt    DateTime?
  masteredAt    DateTime?
  updatedAt     DateTime  @updatedAt
  user          User      @relation("UserSkillMasteries", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeSlug])
  @@index([userId])
}

// ── Virtual Economy ────────────────────────────────────────

model CoinLog {
