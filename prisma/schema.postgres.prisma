  userId      String
  sessionId   String    @unique
  productSlug String
  amount      Int
  currency    String    @default("eur")
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([userId])
  @@index([sessionId])
}

// ── Schulkalender ──────────────────────────────────────────

model SchoolEvent {
