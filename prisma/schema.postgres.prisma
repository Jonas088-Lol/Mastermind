// ── Audit Log ──────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  schoolId  String?
  actorId   String?
  targetId  String?
  action    String
  details   String?
  ip        String?
  createdAt DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ── Postfach ───────────────────────────────────────────────

model MailboxEmail {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  direction   String   // "inbound" | "outbound"

  fromAddress String
  fromName    String?
  toAddress   String
  toName      String?
  subject     String
  bodyText    String
  bodyHtml    String?

  messageId   String?
  inReplyTo   String?
  threadKey   String?

  readAt      DateTime?
  sentAt      DateTime @default(now())

  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, direction, sentAt])
  @@index([threadKey])
  @@index([userId])
}

// ── MasterSpace ────────────────────────────────────────────

model Space {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User     @relation("OwnedSpaces", fields: [ownerId], references: [id])

  name        String
  description String?
  emoji       String   @default("🏠")
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels    SpaceChannel[]
  members     SpaceMember[]

  @@index([schoolId])
  @@index([ownerId])
}

model SpaceChannel {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("text")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  messages          SpaceMessage[]
  voiceParticipants VoiceParticipant[]

  @@index([spaceId, position])
}

model SpaceMember {
  id       String   @id @default(cuid())
  spaceId  String
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member")
  joinedAt DateTime @default(now())

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([spaceId])
}

model SpaceMessage {
  id        String       @id @default(cuid())
  channelId String
  channel   SpaceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("SpaceMessages", fields: [authorId], references: [id])
  content   String
  sentAt    DateTime     @default(now())
  editedAt  DateTime?

  @@index([channelId, sentAt])
  @@index([authorId])
}

model DirectConversation {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("DMsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("DMsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DirectMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User               @relation("SentDirectMessages", fields: [authorId], references: [id])
  content        String
  sentAt         DateTime           @default(now())
  readAt         DateTime?

  @@index([conversationId, sentAt])
  @@index([authorId])
}

// ── Aktivitätsverfolgung & Einwilligung ────────────────────────────────────

model UserConsent {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityTracking Boolean   @default(false)
  version          String    @default("1.0")
  consentedAt      DateTime?
  revokedAt        DateTime?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ActivitySession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionDate     String
  currentPage     String   @default("")
  currentActivity String   @default("")
  isActive        Boolean  @default(false)
  tabFocused      Boolean  @default(true)
  tabSwitches     Int      @default(0)
  activeSeconds   Int      @default(0)
  lastHeartbeat   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, sessionDate])
  @@index([userId])
  @@index([sessionDate])
}

model VoiceParticipant {
  id              String       @id @default(cuid())
  channelId       String
  channel         SpaceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMuted         Boolean      @default(false)
  isDeaf          Boolean      @default(false)
  isSharingScreen Boolean      @default(false)
  joinedAt        DateTime     @default(now())

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

model PersonalEvent {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean   @default(false)
  color       String    @default("#6366f1")
  category    String    @default("personal")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, startAt])
}

// ── Office-Tools ───────────────────────────────────────────

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Unbenanntes Dokument")
  content   String   @default("[]")
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Spreadsheet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Unbenannte Tabelle")
  data      String   @default("{\"cols\":10,\"rows\":30,\"cells\":{},\"colWidths\":{}}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Presentation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Unbenannte Präsentation")
  slides    String   @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ── Hausaufgaben ────────────────────────────────────────────

model Homework {
  id             String      @id @default(cuid())
  teacherId      String
  teacher        User        @relation("TeacherHomework", fields: [teacherId], references: [id])
  classId        String
  class          SchoolClass @relation(fields: [classId], references: [id])
  subjectId      String
  subject        Subject     @relation(fields: [subjectId], references: [id])
  title          String
  description    String?
  dueAt          DateTime
  requiresUpload Boolean     @default(false)
  notifiedAt48h  Boolean     @default(false)
  notifiedAt24h  Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  completions    HomeworkCompletion[]

  @@index([classId])
  @@index([teacherId])
  @@index([classId, dueAt])
}

model HomeworkCompletion {
  id         String    @id @default(cuid())
  homeworkId String
  homework   Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    User      @relation("StudentHomework", fields: [studentId], references: [id])
  done       Boolean   @default(false)
  fileUrl    String?
  fileName   String?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([homeworkId])
}

// ── Global Settings & Events ───────────────────────────────

model GlobalSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ── Season Ranking Archive ─────────────────────────────────

model SeasonRankingEntry {
  id        String  @id @default(cuid())
  seasonId  String
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String
  rank      Int
  score     BigInt  @default(0)
  schoolId  String?

  createdAt DateTime @default(now())

  @@unique([seasonId, userId, category])
  @@index([seasonId])
  @@index([userId])
  @@index([category])
}

// ── Geography ─────────────────────────────────────────────

model Bundesland {
  code       String      @id
  name       String
  landkreise Landkreis[]
  users      User[]      @relation("UserBundesland")
}

model Landkreis {
  id             String     @id
  name           String
  bundeslandCode String
  bundesland     Bundesland @relation(fields: [bundeslandCode], references: [code])
  users          User[]     @relation("UserLandkreis")

  @@index([bundeslandCode])
}

// ── Curriculum ────────────────────────────────────────────

model CurriculumSubject {
  id         String  @id @default(cuid())
  key        String  @unique
  label      String
  color      String
  icon       String
  order      Int     @default(0)

  curriculum Curriculum[]
  treeNodes  TreeNode[]
}

model Curriculum {
  id             String            @id @default(cuid())
  bundeslandCode String
  schulart       Schulart
  jahrgangsstufe Int
  subjectId      String
  subject        CurriculumSubject @relation(fields: [subjectId], references: [id])
  wochenstunden  Int?
  isWahlpflicht  Boolean           @default(false)

  @@unique([bundeslandCode, schulart, jahrgangsstufe, subjectId])
  @@index([bundeslandCode, schulart, jahrgangsstufe])
}

// ── Tree Nodes ────────────────────────────────────────────

model TreeNode {
  id                 String             @id @default(cuid())
  slug               String             @unique
  subjectId          String?
  subject            CurriculumSubject? @relation(fields: [subjectId], references: [id])
  title              String
  description        String
  tier               Int                @default(1)
  isHub              Boolean            @default(false)
  layoutAngle        Float?
  layoutRadius       Float?
  masteryTiers       Int                @default(3)
  requiredQuestCount Int                @default(2)
  requiredLevel      Int?

  prerequisites TreeNodePrereq[]   @relation("nodePrereqs")
  requiredBy    TreeNodePrereq[]   @relation("prereqOf")
  progress      UserTreeProgress[]
  quests        TreeQuest[]
}

model TreeNodePrereq {
  id             String   @id @default(cuid())
  nodeId         String
  requiresNodeId String
  node           TreeNode @relation("nodePrereqs", fields: [nodeId], references: [id], onDelete: Cascade)
  requires       TreeNode @relation("prereqOf",    fields: [requiresNodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, requiresNodeId])
}

model UserTreeProgress {
  id          String         @id @default(cuid())
  userId      String
  nodeId      String
  status      TreeNodeStatus @default(HIDDEN)
  masteryTier Int            @default(0)
  questsDone  Int            @default(0)
  unlockedAt  DateTime?
  masteredAt  DateTime?
  updatedAt   DateTime       @updatedAt
  user        User           @relation("UserTreeProgress", fields: [userId], references: [id], onDelete: Cascade)
  node        TreeNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId])
  @@index([nodeId])
}

// ── Tree Quests ───────────────────────────────────────────

model TreeQuest {
  id          String        @id @default(cuid())
  slug        String        @unique
  nodeId      String
  node        TreeNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  type        TreeQuestType
  title       String
  description String
  target      Int           @default(10)
  rewardXp    Int           @default(50)
  sortOrder   Int           @default(0)

  userQuests UserTreeQuest[]

  @@index([nodeId])
}

model UserTreeQuest {
  id          String     @id @default(cuid())
  userId      String
  questId     String
  progress    Int        @default(0)
  completedAt DateTime?
  assignedAt  DateTime   @default(now())
  expiresAt   DateTime?
  user        User       @relation("UserTreeQuests", fields: [userId], references: [id], onDelete: Cascade)
  quest       TreeQuest  @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
}

// ── Daily Activity (pacing cap) ───────────────────────────

model DailyActivity {
  id              String   @id @default(cuid())
  userId          String
  day             String
  questsDone      Int      @default(0)
  xpEarned        Int      @default(0)
  treeProgressPts Int      @default(0)
  user            User     @relation("DailyActivity", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}
