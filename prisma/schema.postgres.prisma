  endAt       DateTime?
  allDay      Boolean   @default(true)
  category    String    @default("event")
  classIds    String?
  color       String?
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@index([schoolId, startAt])
}

// ── Vertretungsplan ────────────────────────────────────────

model SubstitutionEntry {
  id                  String      @id @default(cuid())
  schoolId            String
  school              School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date                DateTime
  period              Int
  classId             String
  class               SchoolClass @relation(fields: [classId], references: [id])
  absentTeacherId     String?
  absentTeacher       User?       @relation("AbsentTeacher", fields: [absentTeacherId], references: [id])
  substituteTeacherId String?
  substituteTeacher   User?       @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  subjectName         String?
  note                String?
  type                String      @default("substitution")
  room                String?
  createdAt           DateTime    @default(now())

  @@index([schoolId, date])
  @@index([classId])
}

// ── Elterngespräche ────────────────────────────────────────

model TeacherMeetingNote {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    User     @relation("TeacherNotes", fields: [teacherId], references: [id])
  studentId  String
  student    User     @relation("StudentNotes", fields: [studentId], references: [id])
  parentName String?
  meetingAt  DateTime
  notes      String
  followUp   String?
  isPrivate  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([teacherId])
  @@index([studentId])
}

// ── Sitzplan ──────────────────────────────────────────────

model SeatingPlan {
  id        String      @id @default(cuid())
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id])
  subjectId String?
  label     String      @default("Standard")
  layout    String
  rows      Int         @default(5)
  cols      Int         @default(6)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([classId])
}

// ── Einwilligungen ─────────────────────────────────────────

model ConsentForm {
  id             String    @id @default(cuid())
  schoolId       String
  school         School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title          String
  description    String
  deadline       DateTime?
  isActive       Boolean   @default(true)
  targetClassIds String?
  createdAt      DateTime  @default(now())

  responses ConsentResponse[]

  @@index([schoolId])
}

model ConsentResponse {
  id          String      @id @default(cuid())
  formId      String
  form        ConsentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  parentId    String
  parent      User        @relation("ParentConsentResponses", fields: [parentId], references: [id])
  studentId   String
  student     User        @relation("StudentConsentResponses", fields: [studentId], references: [id])
  agreed      Boolean
  signature   String?
  respondedAt DateTime    @default(now())

  @@unique([formId, parentId, studentId])
  @@index([formId])
  @@index([parentId])
}

// ── Elternsprechtag ────────────────────────────────────────

model ParentTeacherSlot {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("TeacherSlots", fields: [teacherId], references: [id])
  startsAt  DateTime
  duration  Int      @default(10)
  isBooked  Boolean  @default(false)
  location  String?
  createdAt DateTime @default(now())

  booking ParentTeacherBooking?

  @@index([teacherId, startsAt])
  @@index([isBooked, startsAt])
}

model ParentTeacherBooking {
  id        String            @id @default(cuid())
  slotId    String            @unique
  slot      ParentTeacherSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User              @relation("ParentBookings", fields: [parentId], references: [id])
  studentId String
  note      String?
  createdAt DateTime          @default(now())

  @@index([parentId])
}

// ── Digitale Hefte ─────────────────────────────────────────

model Notebook {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  subject   String?
  color     String         @default("#6366f1")
  icon      String         @default("📓")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

