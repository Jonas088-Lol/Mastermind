// MasterMind — Prisma Schema (Production: PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Enums ─────────────────────────────────────────────────

enum Rarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
  MYTHIC
  SECRET
}

enum ItemKind {
  COSMETIC
  CONSUMABLE
  GEAR
  TITLE
}

enum Schulart {
  GRUNDSCHULE
  MITTELSCHULE
  REALSCHULE
  GYMNASIUM
  WIRTSCHAFTSSCHULE
  FOS
  BOS
  FOERDERSCHULE
  GESAMTSCHULE
}

enum TreeNodeStatus {
  HIDDEN
  REVEALED
  AVAILABLE
  IN_PROGRESS
  MASTERED
}

enum TreeQuestType {
  EXERCISES
  PPTX
  BOSS_FIGHT
  FLASHCARDS
  STREAK
  QUIZ
  WORKSHEET
  DUEL
}

enum CodeKind {
  SCHOOL_ACTIVATION
  CLASS_JOIN
  TEACHER_JOIN
}

// ── Tenancy ────────────────────────────────────────────────

model School {
  id             String   @id @default(cuid())
  slug           String   @unique
  name           String
  city           String?
  state          String?
  bundeslandCode String?
  plan           String   @default("basic")
  seats       Int      @default(100)
  logoUrl          String?
  logoDarkUrl      String?
  faviconUrl       String?
  accentColor      String?
  brandName        String?  // Anzeigename (falls abweichend vom Schulnamen)
  featureSettings  String   @default("{}")  // JSON: { disabled: string[], windows: Record<string, {from: string, to: string}> }
  mailboxAddress   String?  // Schul-E-Mail-Adresse für das Postfach (z.B. info@schule.de)
  mailboxName      String?  // Anzeigename für ausgehende Mails
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            User[]
  classes          SchoolClass[]
  subjects         Subject[]
  timetableEntries TimetableEntry[]
  messageThreads   MessageThread[]
  periodConfigs    SchoolPeriodConfig[]
  absences         Absence[]
  learningPaths    LearningPath[]
  teams            SchoolTeam[]
  ssoConfigs       SsoConfig[]
  apiTokens        ApiToken[]
  worksheets       Worksheet[]
  seasons          Season[]
  bossBattles      BossBattle[]
  schoolEvents     SchoolEvent[]
  substitutions    SubstitutionEntry[]
  consentForms     ConsentForm[]
  mailboxEmails     MailboxEmail[]
  spaces            Space[]
  provisioningCodes ProvisioningCode[]
  resources         Resource[]        @relation("SchoolResources")
  gradeScale        GradeScale?       @relation("SchoolGradeScale")
}

model SsoConfig {
  id           String   @id @default(cuid())
  schoolId     String
  school       School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  provider     String   // "entra" | "google"
  clientId     String
  clientSecret String
  tenantId     String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([schoolId, provider])
  @@index([schoolId])
}

// ── Auth & Identity ────────────────────────────────────────

model User {
  id              String    @id @default(cuid())
  email           String    @unique
  name            String
  passwordHash    String
  role            String
  klasse          String?
  classId         String?
  pomodoroGoal    Int       @default(4)
  twoFactor       Boolean   @default(false)
  twoFactorSecret String?
  notifPrefs      String?
  prefs           String?
  verifiedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  schoolId    String?
  school      School?     @relation(fields: [schoolId], references: [id])
  schoolClass SchoolClass? @relation("StudentClass", fields: [classId], references: [id])

  sessions          Session[]
  verifications     VerificationToken[]
  taskCompletions   TaskCompletion[]
  notificationReads NotificationRead[]
  aiQuotaEntries    AiQuotaEntry[]
  backupCodes       BackupCode[]

  teacherSubjectClasses TeacherSubjectClass[]
  timetableEntries      TimetableEntry[]      @relation("TimetableTeacher")
  teacherAssignments    Assignment[]          @relation("TeacherAssignments")
  teacherGrades         Grade[]               @relation("TeacherGrades")

  studentSubmissions Submission[]    @relation("StudentSubmissions")
  studentGrades      Grade[]         @relation("StudentGrades")
  flashcardDecks     FlashcardDeck[]

  messageParticipants MessageParticipant[]
  sentMessages        Message[]            @relation("SentMessages")

  appNotifications AppNotification[]

  authoredNotes Note[] @relation("AuthorNotes")
  notebooks     Notebook[]
  vocabLists    VocabList[]

  xp             Int       @default(0)
  xpLogs         XpLog[]
  streak         Int       @default(0)
  lastActiveDate DateTime?

  prestige         Int     @default(0)
  equippedTitle    String?
  comboStreak      Int     @default(0)
  totalDailyLogins Int     @default(0)
  lastLoginDate    String?
  avatarUrl        String?
  bio              String?
  quote            String?
  favoriteSubject  String?
  isSuperAdmin     Boolean  @default(false)
  seasonRankingEntries SeasonRankingEntry[]

  coins          Int     @default(0)
  premiumCoins   Int     @default(0)
  streakFreezes  Int     @default(0)
  isPremium      Boolean @default(false)
  premiumUntil   DateTime?

  coinLogs         CoinLog[]
  inventoryItems   UserInventoryItem[]
  userBoosters     UserBooster[]
  bossProgress     UserBossProgress[]    @relation("UserBossProgress")
  tierProgress     TierProgress[]        @relation("TierProgress")
  userItems        UserItem[]            @relation("UserItems")
  earnedAchievements UserEarnedAchievement[] @relation("UserEarnedAchievements")

  userQuests       UserQuest[]
  userTitles       UserTitle[]
  dailyLoginRewards DailyLoginReward[]
  seasonPasses     UserSeasonPass[]
  bossParticipations BossParticipant[]
  userSkillNodes   UserSkillNode[]
  skillMasteries   UserSkillMastery[] @relation("UserSkillMasteries")

  parentLinks   ParentStudentLink[] @relation("ParentLinks")
  studentParents ParentStudentLink[] @relation("StudentParents")

  reportedAbsences   Absence[] @relation("AbsenceReporter")
  studentAbsences    Absence[] @relation("AbsenceStudent")
  confirmedAbsences  Absence[] @relation("AbsenceConfirmer")
  achievements       UserAchievement[]

  createdLearningPaths LearningPath[]     @relation("CreatedLearningPaths")
  quizAnswers          QuizAnswer[]
  learningProgress     LearningProgress[]

  teacherLessonLogs  LessonLog[]          @relation("TeacherLessonLogs")
  studentAttendance  AttendanceRecord[]   @relation("StudentAttendance")
  teacherAttendance  AttendanceRecord[]   @relation("TeacherAttendance")
  teacherIncidents   ClassbookIncident[]  @relation("TeacherIncidents")
  studentIncidents   ClassbookIncident[]  @relation("StudentIncidents")

  exerciseAnswers    ExerciseAnswer[]
  exerciseProgress   ExerciseProgress[]

  duelsAsChallenger  Duel[]            @relation("DuelChallenger")
  duelsAsChallenged  Duel[]            @relation("DuelChallenged")
  pushSubscriptions  PushSubscription[]
  fileUploads        FileUpload[]

  createdWorksheets         Worksheet[]           @relation("CreatedWorksheets")
  teacherWorksheetAssigns   WorksheetAssignment[] @relation("TeacherWorksheetAssignments")
  worksheetSubmissions      WorksheetSubmission[] @relation("StudentWorksheetSubmissions")

  teacherMeetingNotes  TeacherMeetingNote[] @relation("TeacherNotes")
  studentMeetingNotes  TeacherMeetingNote[] @relation("StudentNotes")
  parentConsentResponses ConsentResponse[]  @relation("ParentConsentResponses")
  studentConsentResponses ConsentResponse[] @relation("StudentConsentResponses")
  teacherSlots         ParentTeacherSlot[]  @relation("TeacherSlots")
  parentBookings       ParentTeacherBooking[] @relation("ParentBookings")
  substitutionsAbsent  SubstitutionEntry[]  @relation("AbsentTeacher")
  substitutionsCovering SubstitutionEntry[] @relation("SubstituteTeacher")
  mailboxEmails         MailboxEmail[]

  lastSeenAt       DateTime?

  userConsent      UserConsent?
  activitySessions ActivitySession[]

  ownedSpaces               Space[]                @relation("OwnedSpaces")
  spaceMemberships          SpaceMember[]
  spaceMessages             SpaceMessage[]         @relation("SpaceMessages")
  spaceMessageReactions     SpaceMessageReaction[] @relation("SpaceMessageReactions")
  dmsAsA                    DirectConversation[]   @relation("DMsAsA")
  dmsAsB                    DirectConversation[]   @relation("DMsAsB")
  sentDirectMsgs            DirectMessage[]        @relation("SentDirectMessages")
  voicePresences            VoiceParticipant[]
  friendsSent               Friendship[]           @relation("FriendsSent")
  friendsReceived           Friendship[]           @relation("FriendsReceived")
  createdProvisioningCodes  ProvisioningCode[]     @relation("CreatedProvisioningCodes")
  personalEvents   PersonalEvent[]
  documents        Document[]
  spreadsheets     Spreadsheet[]
  presentations    Presentation[]

  teacherHomework    Homework[]           @relation("TeacherHomework")
  studentHomework    HomeworkCompletion[] @relation("StudentHomework")

  teacherExercises           TeacherExercise[]           @relation("TeacherExercises")
  teacherExerciseCompletions TeacherExerciseCompletion[] @relation("TeacherExerciseCompletions")

  // ── Curriculum / Skill Tree ──────────────────────────────
  bundeslandCode   String?
  landkreisId      String?
  schulart         Schulart?
  jahrgangsstufe   Int?
  displayName      String?       // Pseudonym for leaderboards
  leaderboardOptIn Boolean       @default(false)
  anonymousMode    Boolean       @default(true)

  bundesland       Bundesland?       @relation("UserBundesland", fields: [bundeslandCode], references: [code])
  landkreis        Landkreis?        @relation("UserLandkreis", fields: [landkreisId], references: [id])
  treeProgress     UserTreeProgress[] @relation("UserTreeProgress")
  treeQuests       UserTreeQuest[]    @relation("UserTreeQuests")
  dailyActivity    DailyActivity[]    @relation("DailyActivity")
  subjectMinutes   UserSubjectMinutes[] @relation("UserSubjectMinutes")
  skillPurchases   UserSkillPurchase[]  @relation("UserSkillPurchases")
  resourceBookings ResourceBooking[]    @relation("UserResourceBookings")

  @@index([role])
  @@index([schoolId])
  @@index([classId])
  @@index([schoolId, role])
}

model BackupCode {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String    @unique
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String   @unique
  expiresAt  DateTime
  ipAddress  String?
  userAgent  String?
  viewAs     String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model VerificationToken {
  id         String    @id @default(cuid())
  userId     String?
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email      String
  type       String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email, type])
  @@index([token])
}

model TaskCompletion {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId String
  doneAt DateTime @default(now())

  @@unique([userId, taskId])
  @@index([userId])
}

model NotificationRead {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  notificationId String
  readAt         DateTime @default(now())

  @@unique([userId, notificationId])
  @@index([userId])
}

model AiQuotaEntry {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  used      Int      @default(0)
  resetAt   DateTime
  updatedAt DateTime @updatedAt
}

// ── Schul-Struktur ─────────────────────────────────────────

model SchoolClass {
  id       String @id @default(cuid())
  name     String // "9b"
  grade    Int    // 9
  schoolId String
  school   School @relation(fields: [schoolId], references: [id])

  students              User[]                @relation("StudentClass")
  teacherSubjectClasses TeacherSubjectClass[]
  timetableEntries      TimetableEntry[]
  assignments           Assignment[]
  lessonLogs            LessonLog[]
  incidents             ClassbookIncident[]
  worksheetAssignments  WorksheetAssignment[]
  seatingPlans          SeatingPlan[]
  substitutions         SubstitutionEntry[]
  homework              Homework[]
  teacherExercises      TeacherExercise[]     @relation("ClassTeacherExercises")

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Subject {
  id        String @id @default(cuid())
  name      String // "Mathematik"
  shortName String // "M"
  color     String @default("#6366f1")
  category  String @default("allgemein")
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id])

  teacherSubjectClasses TeacherSubjectClass[]
  timetableEntries      TimetableEntry[]
  assignments           Assignment[]
  grades                Grade[]
  flashcardDecks        FlashcardDeck[]
  lessonLogs            LessonLog[]
  learningPaths         LearningPath[]
  worksheets            Worksheet[]
  homework              Homework[]

  @@index([schoolId])
}

model TeacherSubjectClass {
  id        String      @id @default(cuid())
  teacherId String
  teacher   User        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id])
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id])

  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@index([classId])
  @@index([subjectId])
}

model TimetableEntry {
  id        String      @id @default(cuid())
  schoolId  String
  school    School      @relation(fields: [schoolId], references: [id])
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id])
  teacherId String
  teacher   User        @relation("TimetableTeacher", fields: [teacherId], references: [id])
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id])
  day       Int // 1=Mo … 5=Fr
  period    Int // 1–9
  room      String?

  @@unique([classId, day, period])
  @@index([classId])
  @@index([teacherId])
}

model ParentStudentLink {
  id        String @id @default(cuid())
  parentId  String
  parent    User   @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  studentId String
  student   User   @relation("StudentParents", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId])
  @@index([parentId])
  @@index([studentId])
}

// ── Aufgaben & Noten ───────────────────────────────────────

model Assignment {
  id          String      @id @default(cuid())
  title       String
  description String?
  dueAt       DateTime
  type        String      @default("homework") // homework | test | project | exam
  maxPoints   Int?
  coverEmoji  String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  teacherId   String
  teacher     User        @relation("TeacherAssignments", fields: [teacherId], references: [id])
  classId     String
  class       SchoolClass @relation(fields: [classId], references: [id])
  subjectId   String
  subject     Subject     @relation(fields: [subjectId], references: [id])

  submissions Submission[]
  fileUploads FileUpload[]

  @@index([classId])
  @@index([teacherId])
  @@index([dueAt])
  @@index([classId, dueAt])
}

model Submission {
  id           String     @id @default(cuid())
  assignmentId String
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User       @relation("StudentSubmissions", fields: [studentId], references: [id])
  content      String?
  status       String     @default("open") // open | submitted | graded | late
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  grade Grade? @relation("SubmissionGrade")

  @@unique([assignmentId, studentId])
  @@index([studentId])
  @@index([assignmentId])
  @@index([status, submittedAt])
  @@index([assignmentId, studentId, status])
}

model Grade {
  id           String      @id @default(cuid())
  studentId    String
  student      User        @relation("StudentGrades", fields: [studentId], references: [id])
  teacherId    String
  teacher      User        @relation("TeacherGrades", fields: [teacherId], references: [id])
  subjectId    String
  subject      Subject     @relation(fields: [subjectId], references: [id])
  submissionId String?     @unique
  submission   Submission? @relation("SubmissionGrade", fields: [submissionId], references: [id])
  value        Float // 1.0–6.0
  weight       Float       @default(1.0)
  type         String // klausur | test | muendlich | hausaufgabe | projekt
  topic        String? // Thema der Note — Basis für die Kompetenz-Heatmap
  comment      String?
  date         DateTime    @default(now())

  @@index([studentId, subjectId])
  @@index([teacherId])
  @@index([date])
}

// ── Nachrichten ────────────────────────────────────────────

model MessageThread {
  id        String   @id @default(cuid())
  subject   String
  schoolId  String
  school    School   @relation(fields: [schoolId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants MessageParticipant[]
  messages     Message[]

  @@index([schoolId, updatedAt])
}

model MessageParticipant {
  id         String        @id @default(cuid())
  threadId   String
  thread     MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId     String
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime?

  @@unique([threadId, userId])
  @@index([userId])
  @@index([userId, lastReadAt])
}

model Message {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User          @relation("SentMessages", fields: [senderId], references: [id])
  content   String
  sentAt    DateTime      @default(now())
  editedAt  DateTime?
  replyToId String?
  replyTo   Message?      @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Message[]     @relation("MessageReplies")

  @@index([threadId, sentAt])
  @@index([senderId])
  @@index([threadId, senderId, sentAt])
  @@index([replyToId])
}

// ── Karteikarten ───────────────────────────────────────────

model FlashcardDeck {
  id        String   @id @default(cuid())
  name      String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cards Flashcard[]

  @@index([userId])
}

model Flashcard {
  id           String        @id @default(cuid())
  deckId       String
  deck         FlashcardDeck @relation(fields: [deckId], references: [id], onDelete: Cascade)
  front        String
  back         String
  nextReviewAt DateTime      @default(now())
  interval     Int           @default(1)
  easeFactor   Float         @default(2.5)
  repetitions  Int           @default(0)

  @@index([deckId])
  @@index([nextReviewAt])
}

// ── Benachrichtigungen ─────────────────────────────────────

model AppNotification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // assignment | grade | message | system
  title     String
  body      String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// ── Klassenbuch ─────────────────────────────────────────────

model LessonLog {
  id        String   @id @default(cuid())
  date      DateTime @default(now())
  period    String   // e.g. "1.-2."
  topic     String
  homework  String?
  signedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teacherId String
  teacher   User        @relation("TeacherLessonLogs", fields: [teacherId], references: [id])
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id])
  subjectId String
  subject   Subject     @relation(fields: [subjectId], references: [id])

  attendanceRecords AttendanceRecord[]

  @@index([teacherId])
  @@index([classId])
  @@index([date])
}

model AttendanceRecord {
  id       String   @id @default(cuid())
  date     DateTime
  status   String   // anwesend | fehlt | verspaetet | entschuldigt
  reason   String?
  signedAt DateTime?
  createdAt DateTime @default(now())

  lessonId  String?
  lesson    LessonLog? @relation(fields: [lessonId], references: [id])
  studentId String
  student   User        @relation("StudentAttendance", fields: [studentId], references: [id])
  teacherId String
  teacher   User        @relation("TeacherAttendance", fields: [teacherId], references: [id])

  @@unique([lessonId, studentId])
  @@index([studentId])
  @@index([date])
}

// ── Community Notizen ──────────────────────────────────────

model Note {
  id        String   @id @default(cuid())
  title     String
  content   String
  isPublic  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorId String
  author   User    @relation("AuthorNotes", fields: [authorId], references: [id], onDelete: Cascade)

  images NoteImage[]

  @@index([authorId])
  @@index([isPublic, createdAt])
}

model ClassbookIncident {
  id        String   @id @default(cuid())
  type      String   // Verweis | Lob | Hinweis
  text      String
  date      DateTime @default(now())
  createdAt DateTime @default(now())

  teacherId String
  teacher   User        @relation("TeacherIncidents", fields: [teacherId], references: [id])
  studentId String
  student   User        @relation("StudentIncidents", fields: [studentId], references: [id])
  classId   String
  class     SchoolClass @relation(fields: [classId], references: [id])

  @@index([teacherId])
  @@index([classId])
  @@index([date])
}

model XpLog {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount       Int
  reason       String   // "aufgabe_abgabe" | "karteikarte" | "note_geteilt" | "aufgabe_bewertet"
  referenceId  String?  // ID der Aufgabe/Note etc.
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
}

model NoteImage {
  id        String   @id @default(cuid())
  noteId    String
  note      Note     @relation(fields: [noteId], references: [id], onDelete: Cascade)
  filename  String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([noteId])
}

model SchoolPeriodConfig {
  id        String @id @default(cuid())
  schoolId  String
  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  period    Int    // 1–9
  startTime String // "08:00"
  endTime   String // "08:45"

  @@unique([schoolId, period])
  @@index([schoolId])
}

model Absence {
  id         String    @id @default(cuid())
  studentId  String
  student    User      @relation("AbsenceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reporterId String
  reporter   User      @relation("AbsenceReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  fromDate   DateTime
  toDate     DateTime
  reason     String?
  status     String    @default("pending") // pending | confirmed | rejected
  confirmedById String?
  confirmedBy   User?     @relation("AbsenceConfirmer", fields: [confirmedById], references: [id], onDelete: SetNull)
  confirmedAt   DateTime?
  createdAt  DateTime  @default(now())

  @@index([studentId])
  @@index([schoolId])
}

model UserAchievement {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug        String   // "first_xp" | "streak_7" | "streak_30" | "level_5" | "notes_10" | "assignments_25"
  unlockedAt  DateTime @default(now())

  @@unique([userId, slug])
  @@index([userId])
}

model LearningPath {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subjectId   String
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  createdById String
  createdBy   User     @relation("CreatedLearningPaths", fields: [createdById], references: [id], onDelete: Cascade)
  modules     LearningModule[]
  progress    LearningProgress[]
  createdAt   DateTime @default(now())

  @@index([schoolId])
  @@index([subjectId])
}

model LearningModule {
  id        String         @id @default(cuid())
  pathId    String
  path      LearningPath   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  title     String
  order     Int
  questions QuizQuestion[]
  progress  LearningProgress[]

  @@index([pathId])
}

model QuizQuestion {
  id          String         @id @default(cuid())
  moduleId    String
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  question    String
  type        String         @default("multiple_choice") // multiple_choice | true_false
  options     String         // JSON array
  correct     String         // correct option index (0-based) as string
  explanation String?
  order       Int
  answers     QuizAnswer[]

  @@index([moduleId])
}

model QuizAnswer {
  id         String       @id @default(cuid())
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  correct    Boolean
  createdAt  DateTime     @default(now())

  @@index([userId])
  @@index([questionId])
}

model LearningProgress {
  id          String         @id @default(cuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  pathId      String
  path        LearningPath   @relation(fields: [pathId], references: [id], onDelete: Cascade)
  moduleId    String
  module      LearningModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  completedAt DateTime       @default(now())

  @@unique([userId, moduleId])
  @@index([userId])
  @@index([pathId])
}

// ── Übungen (plattformweit) ────────────────────────────────

// ── Lehrer-Übungen (eigene Aufgaben für Klassen) ───────────

model TeacherExercise {
  id          String      @id @default(cuid())
  teacherId   String
  teacher     User        @relation("TeacherExercises", fields: [teacherId], references: [id], onDelete: Cascade)
  classId     String
  class       SchoolClass @relation("ClassTeacherExercises", fields: [classId], references: [id], onDelete: Cascade)
  subject     String
  topic       String
  title       String
  description String?
  createdAt   DateTime    @default(now())

  completions TeacherExerciseCompletion[]

  @@index([classId, createdAt])
  @@index([teacherId])
}

model TeacherExerciseCompletion {
  id          String          @id @default(cuid())
  exerciseId  String
  exercise    TeacherExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  studentId   String
  student     User            @relation("TeacherExerciseCompletions", fields: [studentId], references: [id], onDelete: Cascade)
  completedAt DateTime        @default(now())

  @@unique([exerciseId, studentId])
  @@index([studentId])
}

model ExerciseTopic {
  id          String  @id @default(cuid())
  subject     String  // deutsch | mathematik | englisch | physik | chemie | biologie | geschichte | informatik | python | javascript | java | latein | franzosisch | spanisch
  grade       Int     // 1–13
  title       String
  description String?
  order       Int     @default(0)

  lessons   ExerciseLesson[]
  questions ExerciseQuestion[]
  progress  ExerciseProgress[]
  duels     Duel[]

  @@index([subject, grade])
}

model ExerciseLesson {
  id       String        @id @default(cuid())
  topicId  String
  topic    ExerciseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  content  String        // Markdown
  videoUrl String?
  order    Int           @default(0)

  @@index([topicId])
}

model ExerciseQuestion {
  id          String        @id @default(cuid())
  topicId     String
  topic       ExerciseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  type        String        // mc | fill_blank | true_false | order | match | blitz
  question    String
  options     String?       // JSON array
  correct     String        // JSON value or index
  explanation String?
  order       Int           @default(0)

  answers ExerciseAnswer[]

  @@index([topicId])
}

model ExerciseAnswer {
  id         String           @id @default(cuid())
  userId     String
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  questionId String
  question   ExerciseQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  answer     String
  correct    Boolean
  createdAt  DateTime         @default(now())

  @@index([userId])
  @@index([questionId])
}

model ExerciseProgress {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicId     String
  topic       ExerciseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  score       Int           @default(0)
  completedAt DateTime?
  startedAt   DateTime      @default(now())

  @@unique([userId, topicId])
  @@index([userId])
}

// ── Schulmannschaften ──────────────────────────────────────

model SchoolTeam {
  id       String  @id @default(cuid())
  schoolId String
  school   School  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String  // "Fußball Herren", "Basketball Damen"
  sport    String  // fussball | basketball | volleyball | handball | leichtathletik | schwimmen | tennis
  season   String? // "2025/26"
  coach    String?
  results  String? // JSON: array of {date, opponent, scoreHome, scoreAway}

  @@index([schoolId])
}

// ── Duelle ─────────────────────────────────────────────────

model Duel {
  id           String    @id @default(cuid())
  challengerId String
  challenger   User      @relation("DuelChallenger", fields: [challengerId], references: [id], onDelete: Cascade)
  challengedId String
  challenged   User      @relation("DuelChallenged", fields: [challengedId], references: [id], onDelete: Cascade)
  topicId      String
  topic        ExerciseTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)
  status       String    @default("pending") // pending | accepted | completed | declined | expired
  challengerScore Int?
  challengedScore Int?
  winnerId     String?
  message      String?   // optional challenge message
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  completedAt  DateTime?

  @@index([challengerId])
  @@index([challengedId])
  @@index([status])
}

// ── Web Push Subscriptions ─────────────────────────────────

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// ── Großdatei-Uploads ─────────────────────────────────────────

model FileUpload {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename     String
  mimeType     String
  size         Int      // bytes
  path         String   // storage path
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([assignmentId])
}

// ── Feature Flags ──────────────────────────────────────────

model FeatureFlag {
  id          String   @id @default(cuid())
  name        String   @unique
  description String
  state       String   @default("off") // on | off | rollout | experiment
  rollout     Int      @default(0)     // 0–100 percent
  scope       String   @default("alle")
  owner       String   @default("Plattform")
  metric      String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model ApiToken {
  id         String    @id @default(cuid())
  schoolId   String
  school     School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  scopes     String    @default("read")
  lastUsedAt DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([schoolId])
}

// ── Arbeitsblätter (Interactive Worksheet Engine) ──────────

model Worksheet {
  id               String   @id @default(cuid())
  schoolId         String
  school           School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  creatorId        String
  creator          User     @relation("CreatedWorksheets", fields: [creatorId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  subjectId        String?
  subject          Subject? @relation(fields: [subjectId], references: [id])
  gradeLevel       Int?
  difficulty       String   @default("mittel")
  estimatedMinutes Int      @default(15)
  status           String   @default("draft")
  isTemplate       Boolean  @default(false)
  language         String   @default("de")
  items            WorksheetItem[]
  assignments      WorksheetAssignment[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([schoolId])
  @@index([creatorId])
}

model WorksheetItem {
  id            String    @id @default(cuid())
  worksheetId   String
  worksheet     Worksheet @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  type          String
  order         Int
  config        String
  correctAnswer String?
  hint          String?
  points        Int       @default(1)
  required      Boolean   @default(true)
  answers       WorksheetItemAnswer[]

  @@index([worksheetId])
}

model WorksheetAssignment {
  id           String       @id @default(cuid())
  worksheetId  String
  worksheet    Worksheet    @relation(fields: [worksheetId], references: [id], onDelete: Cascade)
  classId      String?
  class        SchoolClass? @relation(fields: [classId], references: [id])
  teacherId    String
  teacher      User         @relation("TeacherWorksheetAssignments", fields: [teacherId], references: [id], onDelete: Cascade)
  assignedAt   DateTime     @default(now())
  dueAt        DateTime?
  maxAttempts  Int          @default(1)
  showHints    Boolean      @default(true)
  showSolution Boolean      @default(false)
  submissions  WorksheetSubmission[]

  @@index([worksheetId])
  @@index([classId])
}

model WorksheetSubmission {
  id           String              @id @default(cuid())
  assignmentId String
  assignment   WorksheetAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  studentId    String
  student      User                @relation("StudentWorksheetSubmissions", fields: [studentId], references: [id], onDelete: Cascade)
  startedAt    DateTime            @default(now())
  submittedAt  DateTime?
  score        Int?
  maxScore     Int?
  timeTakenSec Int?
  status       String              @default("in_progress")
  itemAnswers  WorksheetItemAnswer[]

  @@index([assignmentId])
  @@index([studentId])
}

model WorksheetItemAnswer {
  id           String              @id @default(cuid())
  submissionId String
  submission   WorksheetSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  itemId       String
  item         WorksheetItem       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  answer       String
  isCorrect    Boolean?
  pointsEarned Int?
  answeredAt   DateTime            @default(now())

  @@unique([submissionId, itemId])
  @@index([submissionId])
}

// ── Gamification ───────────────────────────────────────────

model Quest {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  lore        String?
  type        String   // daily | weekly | monthly | event | boss | hidden | story
  category    String   // xp | submission | flashcard | streak | duel | exercise | community | login | quest
  targetCount Int      @default(1)
  xpReward    Int      @default(50)
  titleReward String?
  icon        String   @default("⚔️")
  difficulty  String   @default("normal") // tutorial | easy | normal | hard | epic | legendary | nightmare | boss
  rarity      String   @default("common") // common | uncommon | rare | epic | legendary | mythic
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  userProgress UserQuest[]
}

model UserQuest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  questId     String
  quest       Quest     @relation(fields: [questId], references: [id], onDelete: Cascade)
  progress    Int       @default(0)
  completedAt DateTime?
  claimedAt   DateTime?
  assignedAt  DateTime  @default(now())
  expiresAt   DateTime?

  @@unique([userId, questId])
  @@index([userId])
  @@index([questId])
}

model UserTitle {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleSlug  String
  unlockedAt DateTime  @default(now())

  @@unique([userId, titleSlug])
  @@index([userId])
}

model DailyLoginReward {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  day       Int
  xpAwarded Int
  claimedAt DateTime @default(now())

  @@index([userId])
}

model Season {
  id       String   @id @default(cuid())
  schoolId String?
  school   School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name     String
  number   Int
  theme    String?
  startAt  DateTime
  endAt    DateTime
  isActive Boolean  @default(false)

  passes         UserSeasonPass[]
  rankingEntries SeasonRankingEntry[]

  @@index([schoolId])
  @@index([isActive])
}

model UserSeasonPass {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seasonId String
  season   Season @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  xpEarned Int    @default(0)
  tier     Int    @default(0)

  @@unique([userId, seasonId])
  @@index([userId])
}

model BossBattle {
  id               String   @id @default(cuid())
  schoolId         String?
  school           School?  @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  name             String
  description      String
  lore             String?
  subject          String?
  gradeLevel       Int?
  tier             String   @default("common")
  maxHp            Int      @default(20)
  currentHp        Int      @default(20)
  difficulty       String   @default("hard")
  coinReward       Int      @default(8)
  mvpCoinReward    Int      @default(25)
  xpReward         Int      @default(100)
  icon             String   @default("👹")
  startAt          DateTime
  endAt            DateTime
  isActive         Boolean  @default(false)
  firstBloodUserId   String?
  killedByUserId     String?
  createdByUserId    String?
  useCustomQuestions Boolean @default(false)

  participants BossParticipant[]
  questions    BossQuestion[]

  @@index([schoolId])
  @@index([isActive])
}

model BossQuestion {
  id          String     @id @default(cuid())
  battleId    String
  battle      BossBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  question    String
  optionA     String
  optionB     String
  optionC     String
  optionD     String
  correct     Int
  aiGenerated Boolean    @default(false)
  createdAt   DateTime   @default(now())

  seen        BossQuestionSeen[]

  @@index([battleId])
}

model BossQuestionSeen {
  id              String       @id @default(cuid())
  userId          String
  questionId      String
  answeredCorrect Boolean
  question        BossQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  seenAt          DateTime     @default(now())

  @@unique([userId, questionId])
  @@index([userId, questionId])
}

model BossParticipant {
  id             String     @id @default(cuid())
  userId         String
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  battleId       String
  battle         BossBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  damage         Int        @default(0)
  correctAnswers Int        @default(0)
  wrongAnswers   Int        @default(0)
  coinsEarned    Int        @default(0)
  isMvp          Boolean    @default(false)
  firstBlood     Boolean    @default(false)
  lastHit        Boolean    @default(false)
  joinedAt       DateTime   @default(now())

  @@unique([userId, battleId])
  @@index([userId])
  @@index([battleId])
  @@index([userId, damage])
  @@index([userId, isMvp])
}

model SkillNode {
  id          String  @id @default(cuid())
  subject     String
  slug        String
  title       String
  description String
  tier        Int     @default(1)
  requiredXp  Int     @default(0)
  icon        String  @default("⭐")
  color       String  @default("#6366f1")
  parentSlug  String?
  xpBonus     Int     @default(0)
  sortOrder   Int     @default(0)

  userNodes UserSkillNode[]

  @@unique([subject, slug])
}

model UserSkillNode {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  nodeId      String
  node        SkillNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  unlockedAt  DateTime  @default(now())

  @@unique([userId, nodeId])
  @@index([userId])
}

// ── Virtual Economy ────────────────────────────────────────

model CoinLog {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int      // positive = earned, negative = spent
  reason      String   // "quest_reward" | "daily_login" | "exercise" | "shop_purchase" | "stripe_purchase" | ...
  referenceId String?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model ShopItem {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String   // "booster" | "streak_freeze" | "cosmetic" | "title" | "powerup" | "bundle"
  coinPrice   Int      @default(0)    // 0 = real-money only
  realPrice   Int?                    // cents, null = coins only
  icon        String   @default("🎁")
  rarity      String   @default("common") // common | uncommon | rare | epic | legendary
  effect      String?  // "xp_boost" | "streak_freeze" | "ai_quota" | "cosmetic" | ...
  effectValue String?  // JSON or plain value
  isLimited   Boolean  @default(false)
  stock       Int?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model UserInventoryItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemSlug    String
  quantity    Int       @default(1)
  acquiredAt  DateTime  @default(now())
  expiresAt   DateTime?

  @@index([userId])
  @@index([itemSlug])
}

model UserBooster {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  boosterSlug String    // references ShopItem.slug
  multiplier  Float
  activatedAt DateTime  @default(now())
  expiresAt   DateTime

  @@index([userId])
  @@index([expiresAt])
}

model StripeOrder {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String   @unique
  productSlug     String   // "coins_100" | "coins_500" | "premium_month" | ...
  amount          Int      // cents
  currency        String   @default("eur")
  status          String   @default("pending") // pending | completed | failed
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@index([userId])
  @@index([sessionId])
}

// ── Mollie Payments ────────────────────────────────────────

model MollieOrder {
  id            String    @id @default(cuid())
  userId        String
  mollieId      String    @unique   // Mollie payment id, e.g. "tr_xxxxx"
  productSlug   String               // "coins_100" | "coins_500" | ...
  coinsAwarded  Int                  // total coins incl. bonus
  amountEur     String               // decimal string, e.g. "9.99"
  status        String    @default("open")
  // open | pending | authorized | expired | canceled | failed | paid
  method        String?              // "creditcard" | "paypal" | "applepay" | ...
  createdAt     DateTime  @default(now())
  paidAt        DateTime?

  @@index([userId])
  @@index([status])
}

// ── Schulkalender ──────────────────────────────────────────

model SchoolEvent {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean  @default(true)
  category    String   @default("event") // "holiday" | "exam" | "event" | "deadline" | "meeting"
  classIds    String?  // JSON array of class IDs — null = all classes
  color       String?
  createdBy   String?
  createdAt   DateTime @default(now())

  @@index([schoolId, startAt])
}

// ── Vertretungsplan ────────────────────────────────────────

model SubstitutionEntry {
  id                  String   @id @default(cuid())
  schoolId            String
  school              School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  date                DateTime
  period              Int
  classId             String
  class               SchoolClass @relation(fields: [classId], references: [id])
  absentTeacherId     String?
  absentTeacher       User?    @relation("AbsentTeacher", fields: [absentTeacherId], references: [id])
  substituteTeacherId String?
  substituteTeacher   User?    @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  subjectName         String?
  note                String?
  type                String   @default("substitution") // "substitution" | "cancellation" | "room_change"
  room                String?
  createdAt           DateTime @default(now())

  @@index([schoolId, date])
  @@index([classId])
}

// ── Elterngespräche ────────────────────────────────────────

model TeacherMeetingNote {
  id         String   @id @default(cuid())
  teacherId  String
  teacher    User     @relation("TeacherNotes", fields: [teacherId], references: [id])
  studentId  String
  student    User     @relation("StudentNotes", fields: [studentId], references: [id])
  parentName String?
  meetingAt  DateTime
  notes      String
  followUp   String?
  isPrivate  Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([teacherId])
  @@index([studentId])
}

// ── Sitzplan ──────────────────────────────────────────────

model SeatingPlan {
  id          String   @id @default(cuid())
  classId     String
  class       SchoolClass @relation(fields: [classId], references: [id])
  subjectId   String?
  label       String   @default("Standard")
  layout      String   // JSON: [{row:0,col:0,studentId:"..."}]
  rows        Int      @default(5)
  cols        Int      @default(6)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([classId])
}

// ── Einwilligungen (Eltern) ────────────────────────────────

model ConsentForm {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  title       String
  description String
  deadline    DateTime?
  isActive    Boolean  @default(true)
  targetClassIds String? // JSON — null = all classes
  createdAt   DateTime @default(now())

  responses   ConsentResponse[]

  @@index([schoolId])
}

model ConsentResponse {
  id          String      @id @default(cuid())
  formId      String
  form        ConsentForm @relation(fields: [formId], references: [id], onDelete: Cascade)
  parentId    String
  parent      User        @relation("ParentConsentResponses", fields: [parentId], references: [id])
  studentId   String
  student     User        @relation("StudentConsentResponses", fields: [studentId], references: [id])
  agreed      Boolean
  signature   String?
  respondedAt DateTime    @default(now())

  @@unique([formId, parentId, studentId])
  @@index([formId])
  @@index([parentId])
}

// ── Elternsprechtag ────────────────────────────────────────

model ParentTeacherSlot {
  id        String   @id @default(cuid())
  teacherId String
  teacher   User     @relation("TeacherSlots", fields: [teacherId], references: [id])
  startsAt  DateTime
  duration  Int      @default(10) // minutes
  isBooked  Boolean  @default(false)
  location  String?
  createdAt DateTime @default(now())

  booking   ParentTeacherBooking?

  @@index([teacherId, startsAt])
  @@index([isBooked, startsAt])
}

model ParentTeacherBooking {
  id        String            @id @default(cuid())
  slotId    String            @unique
  slot      ParentTeacherSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  parentId  String
  parent    User              @relation("ParentBookings", fields: [parentId], references: [id])
  studentId String
  note      String?
  createdAt DateTime          @default(now())

  @@index([parentId])
}

// ── Digitale Hefte (Block-Editor) ─────────────────────────

model Notebook {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  subject   String?
  color     String         @default("#6366f1")
  icon      String         @default("📓")
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  pages     NotebookPage[]

  @@index([userId])
}

model NotebookPage {
  id         String   @id @default(cuid())
  notebookId String
  notebook   Notebook @relation(fields: [notebookId], references: [id], onDelete: Cascade)
  title      String   @default("Neue Seite")
  content    String   @default("[]")
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([notebookId])
}

// ── Vokabeltrainer ─────────────────────────────────────────

model VocabList {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  langFrom  String       @default("Deutsch")
  langTo    String       @default("Englisch")
  subject   String?
  isPublic  Boolean      @default(false)
  color     String       @default("#6366f1")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  entries   VocabEntry[]

  @@index([userId])
}

model VocabEntry {
  id          String    @id @default(cuid())
  listId      String
  list        VocabList @relation(fields: [listId], references: [id], onDelete: Cascade)
  word        String
  translation String
  example     String?
  hint        String?
  nextReview  DateTime  @default(now())
  interval    Int       @default(1)
  easeFactor  Float     @default(2.5)
  repetitions Int       @default(0)
  streak      Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([listId])
  @@index([nextReview])
}

// ── Audit Log ──────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  schoolId   String?
  actorId    String?
  targetId   String?
  action     String
  details    String?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// ── Postfach ───────────────────────────────────────────────

model MailboxEmail {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  direction   String   // "inbound" | "outbound"

  fromAddress String
  fromName    String?
  toAddress   String
  toName      String?
  subject     String
  bodyText    String
  bodyHtml    String?

  // E-Mail-Threading via RFC 5322 Header
  messageId   String?
  inReplyTo   String?
  threadKey   String?  // erster messageId im Thread — gruppiert Antworten

  readAt      DateTime?
  sentAt      DateTime @default(now())

  // Welcher Admin hat die Mail gesendet/empfangen
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([schoolId, direction, sentAt])
  @@index([threadKey])
  @@index([userId])
}

// ── MasterSpace ────────────────────────────────────────────

model Space {
  id          String   @id @default(cuid())
  schoolId    String
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  ownerId     String
  owner       User     @relation("OwnedSpaces", fields: [ownerId], references: [id])

  name        String
  description String?
  emoji       String   @default("🏠")
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channels    SpaceChannel[]
  members     SpaceMember[]

  @@index([schoolId])
  @@index([ownerId])
}

model SpaceChannel {
  id        String   @id @default(cuid())
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  name      String
  type      String   @default("text") // "text" | "voice"
  position  Int      @default(0)
  createdAt DateTime @default(now())

  messages          SpaceMessage[]
  voiceParticipants VoiceParticipant[]

  @@index([spaceId, position])
}

model SpaceMember {
  id       String   @id @default(cuid())
  spaceId  String
  space    Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role     String   @default("member") // "owner" | "admin" | "member"
  joinedAt DateTime @default(now())

  @@unique([spaceId, userId])
  @@index([userId])
  @@index([spaceId])
}

model SpaceMessage {
  id        String       @id @default(cuid())
  channelId String
  channel   SpaceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  authorId  String
  author    User         @relation("SpaceMessages", fields: [authorId], references: [id])
  content   String
  parentId  String?
  parent    SpaceMessage?  @relation("Replies", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   SpaceMessage[] @relation("Replies")
  sentAt    DateTime     @default(now())
  editedAt  DateTime?
  deletedAt DateTime?
  flagged   Boolean      @default(false)

  reactions SpaceMessageReaction[]

  @@index([channelId, sentAt])
  @@index([authorId])
  @@index([parentId])
}

model SpaceMessageReaction {
  id        String       @id @default(cuid())
  messageId String
  message   SpaceMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation("SpaceMessageReactions", fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime     @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@index([userId])
}

model DirectConversation {
  id        String   @id @default(cuid())
  userAId   String
  userA     User     @relation("DMsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userBId   String
  userB     User     @relation("DMsAsB", fields: [userBId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages  DirectMessage[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
}

model DirectMessage {
  id             String             @id @default(cuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String
  author         User               @relation("SentDirectMessages", fields: [authorId], references: [id])
  content        String
  sentAt         DateTime           @default(now())
  readAt         DateTime?

  @@index([conversationId, sentAt])
  @@index([authorId])
}

// ── Aktivitätsverfolgung & Einwilligung ────────────────────────────────────

model UserConsent {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  activityTracking Boolean   @default(false) // Tab-Wechsel, Aktivzeit, aktuelle Seite
  version          String    @default("1.0") // Einwilligungsversion
  consentedAt      DateTime?
  revokedAt        DateTime?
  ipAddress        String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model ActivitySession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionDate     String   // YYYY-MM-DD
  currentPage     String   @default("")
  currentActivity String   @default("") // lesbare Beschreibung
  isActive        Boolean  @default(false)
  tabFocused      Boolean  @default(true)
  tabSwitches     Int      @default(0)
  activeSeconds   Int      @default(0)
  lastHeartbeat   DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([userId, sessionDate])
  @@index([userId])
  @@index([sessionDate])
}

model VoiceParticipant {
  id              String       @id @default(cuid())
  channelId       String
  channel         SpaceChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  isMuted         Boolean      @default(false)
  isDeaf          Boolean      @default(false)
  isSharingScreen Boolean      @default(false)
  isCameraOn      Boolean      @default(false)
  joinedAt        DateTime     @default(now())

  @@unique([channelId, userId])
  @@index([channelId])
  @@index([userId])
}

model Friendship {
  id          String   @id @default(cuid())
  requesterId String
  requester   User     @relation("FriendsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId String
  addressee   User     @relation("FriendsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)
  status      String   @default("pending") // "pending" | "accepted" | "declined"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([requesterId, addresseeId])
  @@index([requesterId])
  @@index([addresseeId])
}

model PersonalEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  startAt     DateTime
  endAt       DateTime?
  allDay      Boolean  @default(false)
  color       String   @default("#6366f1")
  category    String   @default("personal") // "personal" | "exam" | "appointment"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, startAt])
}

// ── Office-Tools ───────────────────────────────────────────

model Document {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Unbenanntes Dokument")
  content   String   @default("[]") // JSON blocks (same format as BlockEditor)
  isShared  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Spreadsheet {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Unbenannte Tabelle")
  data      String   @default("{\"cols\":10,\"rows\":30,\"cells\":{},\"colWidths\":{}}") // JSON
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Presentation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("Unbenannte Präsentation")
  slides    String   @default("[]") // JSON slides array
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ── Hausaufgaben ────────────────────────────────────────────

model Homework {
  id             String      @id @default(cuid())
  teacherId      String
  teacher        User        @relation("TeacherHomework", fields: [teacherId], references: [id])
  classId        String
  class          SchoolClass @relation(fields: [classId], references: [id])
  subjectId      String
  subject        Subject     @relation(fields: [subjectId], references: [id])
  title          String
  description    String?
  dueAt          DateTime
  requiresUpload Boolean     @default(false)
  notifiedAt48h  Boolean     @default(false)
  notifiedAt24h  Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  completions    HomeworkCompletion[]

  @@index([classId])
  @@index([teacherId])
  @@index([classId, dueAt])
}

model HomeworkCompletion {
  id         String    @id @default(cuid())
  homeworkId String
  homework   Homework  @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  studentId  String
  student    User      @relation("StudentHomework", fields: [studentId], references: [id])
  done       Boolean   @default(false)
  fileUrl    String?
  fileName   String?
  doneAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@unique([homeworkId, studentId])
  @@index([studentId])
  @@index([homeworkId])
}

// ── Global Settings & Events ───────────────────────────────

model GlobalSetting {
  key       String   @id
  value     String   @default("")
  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ── Season Ranking Archive ─────────────────────────────────

model SeasonRankingEntry {
  id        String  @id @default(cuid())
  seasonId  String
  season    Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  String  // "xp" | "coins" | "boss" | "streak" | "mvp" | "lernzeit"
  rank      Int
  score     BigInt  @default(0)
  schoolId  String?

  createdAt DateTime @default(now())

  @@unique([seasonId, userId, category])
  @@index([seasonId])
  @@index([userId])
  @@index([category])
}

// ── Skill Mastery ──────────────────────────────────────────

model UserSkillMastery {
  id            String    @id @default(cuid())
  userId        String
  nodeSlug      String
  masteryTier   Int       @default(0)
  exercisesDone Int       @default(0)
  unlockedAt    DateTime?
  masteredAt    DateTime?
  updatedAt     DateTime  @updatedAt
  user          User      @relation("UserSkillMasteries", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeSlug])
  @@index([userId])
}

// ── Geography (Leaderboard Scopes) ────────────────────────

model Bundesland {
  code      String      @id   // "BY", "NW", "BW", …
  name      String
  landkreise Landkreis[]
  users     User[]      @relation("UserBundesland")
}

model Landkreis {
  id             String     @id   // "BY-SK-MUC", "BY-LK-DAH", …
  name           String
  bundeslandCode String
  bundesland     Bundesland @relation(fields: [bundeslandCode], references: [code])
  users          User[]     @relation("UserLandkreis")

  @@index([bundeslandCode])
}

// ── Curriculum Subjects (global, not per-school) ──────────

model CurriculumSubject {
  id         String  @id @default(cuid())
  key        String  @unique   // "mathematik", "deutsch", …
  label      String
  color      String
  icon       String
  order      Int     @default(0)

  curriculum Curriculum[]
  treeNodes  TreeNode[]
}

// Lehrplan: (Bundesland × Schulart × Jahrgangsstufe) → Fach
model Curriculum {
  id             String            @id @default(cuid())
  bundeslandCode String
  schulart       Schulart
  jahrgangsstufe Int
  subjectId      String
  subject        CurriculumSubject @relation(fields: [subjectId], references: [id])
  wochenstunden  Int?
  isWahlpflicht  Boolean           @default(false)

  @@unique([bundeslandCode, schulart, jahrgangsstufe, subjectId])
  @@index([bundeslandCode, schulart, jahrgangsstufe])
}

// ── Skill Tree (curriculum-driven) ───────────────────────

model TreeNode {
  id                 String             @id @default(cuid())
  slug               String             @unique
  subjectId          String?
  subject            CurriculumSubject? @relation(fields: [subjectId], references: [id])
  title              String
  description        String
  tier               Int                @default(1)
  isHub              Boolean            @default(false)
  layoutAngle        Float?
  layoutRadius       Float?
  masteryTiers       Int                @default(3)
  requiredQuestCount Int                @default(2)
  requiredLevel      Int?

  prerequisites TreeNodePrereq[]  @relation("nodePrereqs")
  requiredBy    TreeNodePrereq[]  @relation("prereqOf")
  progress      UserTreeProgress[]
  quests        TreeQuest[]
}

model TreeNodePrereq {
  id             String   @id @default(cuid())
  nodeId         String
  requiresNodeId String
  node           TreeNode @relation("nodePrereqs", fields: [nodeId], references: [id], onDelete: Cascade)
  requires       TreeNode @relation("prereqOf",    fields: [requiresNodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, requiresNodeId])
}

model UserTreeProgress {
  id          String         @id @default(cuid())
  userId      String
  nodeId      String
  status      TreeNodeStatus @default(HIDDEN)
  masteryTier Int            @default(0)
  questsDone  Int            @default(0)
  unlockedAt  DateTime?
  masteredAt  DateTime?
  updatedAt   DateTime       @updatedAt
  user        User           @relation("UserTreeProgress", fields: [userId], references: [id], onDelete: Cascade)
  node        TreeNode       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeId])
  @@index([userId])
  @@index([nodeId])
}

// ── Tree Quests ───────────────────────────────────────────

model TreeQuest {
  id          String        @id @default(cuid())
  slug        String        @unique
  nodeId      String
  node        TreeNode      @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  type        TreeQuestType
  title       String
  description String
  target      Int           @default(10)
  rewardXp    Int           @default(50)
  sortOrder   Int           @default(0)

  userQuests UserTreeQuest[]

  @@index([nodeId])
}

model UserTreeQuest {
  id          String      @id @default(cuid())
  userId      String
  questId     String
  progress    Int         @default(0)
  completedAt DateTime?
  assignedAt  DateTime    @default(now())
  expiresAt   DateTime?
  user        User        @relation("UserTreeQuests", fields: [userId], references: [id], onDelete: Cascade)
  quest       TreeQuest   @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId])
}

// ── Daily Activity (pacing cap) ───────────────────────────

model DailyActivity {
  id              String   @id @default(cuid())
  userId          String
  day             String   // ISO date "YYYY-MM-DD"
  questsDone      Int      @default(0)
  xpEarned        Int      @default(0)
  treeProgressPts Int      @default(0)   // capped at PACING.dailyProgressCap
  user            User     @relation("DailyActivity", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
}

// ── Boss Definitions (static catalog) ─────────────────────

model BossDef {
  id         String   @id          // e.g. "zahlenschatten"
  name       String
  subject    String               // "Mathematik" | "Deutsch" | ... | "Alle Fächer"
  emoji      String
  rarity     Rarity
  minGrade   Int      @default(5)
  maxGrade   Int      @default(12)
  baseHp     Int
  baseXp     Int
  baseCoins  Int
  loreShort  String   @default("")
  custom     Boolean  @default(false)  // true = bespoke hand-built component
  mvpTarget  Int      @default(10)     // MVP kills needed for tier completion

  progress   UserBossProgress[]

  @@index([rarity])
  @@index([subject])
}

model UserBossProgress {
  id             String   @id @default(cuid())
  userId         String
  bossId         String
  kills          Int      @default(0)
  mvpKills       Int      @default(0)
  titleUnlocked  Boolean  @default(false)
  lastKillAt     DateTime?
  user           User     @relation("UserBossProgress", fields: [userId], references: [id], onDelete: Cascade)
  boss           BossDef  @relation(fields: [bossId], references: [id], onDelete: Cascade)

  @@unique([userId, bossId])
  @@index([userId])
  @@index([bossId])
}

model TierProgress {
  id       String  @id @default(cuid())
  userId   String
  rarity   Rarity
  mvpKills Int     @default(0)
  unlocked Boolean @default(false)
  user     User    @relation("TierProgress", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, rarity])
  @@index([userId])
}

// ── Item Shop ─────────────────────────────────────────────

model ItemDef {
  id            String    @id @default(cuid())
  key           String    @unique
  name          String
  description   String    @default("")
  kind          ItemKind
  rarity        Rarity
  priceCoins    Int?
  pricePremium  Int?
  componentKey  String              // maps to a React component key
  meta          String    @default("{}")  // JSON extras (equip slot, effect, etc.)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  listings    ShopListing[]
  owned       UserItem[]

  @@index([kind])
  @@index([rarity])
}

model ShopListing {
  id         String    @id @default(cuid())
  itemId     String
  item       ItemDef   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  activeFrom DateTime?
  activeTo   DateTime?
  featured   Boolean   @default(false)

  @@index([itemId])
}

model UserItem {
  id       String   @id @default(cuid())
  userId   String
  itemId   String
  equipped Boolean  @default(false)
  qty      Int      @default(1)
  acquiredAt DateTime @default(now())
  user     User     @relation("UserItems", fields: [userId], references: [id], onDelete: Cascade)
  item     ItemDef  @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
  @@index([userId])
}

// ── Achievement Catalog ───────────────────────────────────

model AchievementDef {
  id          String  @id @default(cuid())
  key         String  @unique
  name        String
  description String
  icon        String
  xpReward    Int     @default(0)
  rarity      Rarity  @default(COMMON)
  secret      Boolean @default(false)

  earned UserEarnedAchievement[]
}

model UserEarnedAchievement {
  id            String         @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime       @default(now())
  user          User           @relation("UserEarnedAchievements", fields: [userId], references: [id], onDelete: Cascade)
  achievement   AchievementDef @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
}

// ── Provisioning Codes ────────────────────────────────────

model ProvisioningCode {
  id          String    @id @default(cuid())
  code        String    @unique
  kind        CodeKind
  schoolId    String?
  school      School?   @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  classId     String?
  maxUses     Int       @default(1)
  uses        Int       @default(0)
  expiresAt   DateTime?
  revoked     Boolean   @default(false)
  note        String?
  createdById String
  createdBy   User      @relation("CreatedProvisioningCodes", fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([schoolId])
  @@index([code])
  @@index([kind])
}

// ── Premium Wallet extension ──────────────────────────────
// premiumCoins stored directly on User (migration adds column)

model UserSubjectMinutes {
  id           String   @id @default(cuid())
  userId       String
  subjectKey   String
  totalMinutes Float    @default(0)
  updatedAt    DateTime @updatedAt
  user         User     @relation("UserSubjectMinutes", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, subjectKey])
  @@index([userId])
}

model UserSkillPurchase {
  id          String   @id @default(cuid())
  userId      String
  nodeKey     String
  purchasedAt DateTime @default(now())
  user        User     @relation("UserSkillPurchases", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, nodeKey])
  @@index([userId])
}

// ── Ressourcen-Reservierung ────────────────────────────────
model Resource {
  id          String            @id @default(cuid())
  schoolId    String
  name        String
  description String?
  category    String            @default("sonstiges") // "raum" | "geraet" | "sonstiges"
  icon        String?
  color       String            @default("#6366f1")
  bookings    ResourceBooking[]
  school      School            @relation("SchoolResources", fields: [schoolId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([schoolId])
}

model ResourceBooking {
  id         String   @id @default(cuid())
  resourceId String
  userId     String
  title      String
  startsAt   DateTime
  endsAt     DateTime
  note       String?
  resource   Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  user       User     @relation("UserResourceBookings", fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([resourceId])
  @@index([userId])
}

// ── Notenschlüssel ─────────────────────────────────────────
model GradeScale {
  id        String            @id @default(cuid())
  schoolId  String            @unique
  name      String            @default("Standard-Notenschlüssel")
  school    School            @relation("SchoolGradeScale", fields: [schoolId], references: [id], onDelete: Cascade)
  entries   GradeScaleEntry[]
  updatedAt DateTime          @updatedAt
}

model GradeScaleEntry {
  id           String     @id @default(cuid())
  gradeScaleId String
  grade        String     // "1", "2", "3", "4", "5", "6"
  label        String     // "Sehr gut", "Gut", etc.
  minPercent   Float      // minimum percentage (inclusive) to achieve this grade
  gradeScale   GradeScale @relation(fields: [gradeScaleId], references: [id], onDelete: Cascade)

  @@unique([gradeScaleId, grade])
  @@index([gradeScaleId])
}

// ── Fragen-Pool (KI-generiert) ──────────────────────────────
// SQLite-Dev-Schema: antworten/loesung als JSON-String (kein Array/Json in SQLite).
// Produktions-Schema (schema.postgres.prisma) verwendet Json + String[].
model Frage {
  id                 String   @id @default(cuid())
  schulart           String
  bundesland         String
  jahrgangsstufe     Int
  fach               String
  thema              String
  unterthema         String?
  schwierigkeit      Int
  schwierigkeitScore Float
  typ                String   @default("single_choice")
  frage              String
  antworten          String   // JSON-encoded [{id,text,korrekt}…]
  loesung            String   // JSON-encoded String[]
  erklaerung         String
  modell             String   @default("ki-generiert")
  quelle             String   @default("ki-generiert")
  generiertAm        DateTime @default(now())

  @@index([schulart, bundesland, jahrgangsstufe, fach, thema, schwierigkeit, schwierigkeitScore])
  @@index([fach, jahrgangsstufe, schwierigkeit])
}

// ── Drive (Schul-eigener File-Storage) ────────────────────

model DriveFile {
  id         String   @id @default(cuid())
  name       String
  mimeType   String
  size       Int
  path       String   // relative path: "drive/[userId]/[filename]"
  userId     String
  schoolId   String?
  isPublic   Boolean  @default(false) // true = sichtbar für alle Schulnutzer
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([schoolId])
}

// ── Schulinterne Lernzettel (Wiki) ────────────────────────

model SchoolWikiEntry {
  id         String   @id @default(cuid())
  title      String
  content    String   @default("")
  subject    String?
  tags       String   @default("") // komma-getrennte Tags
  authorId   String
  schoolId   String
  viewCount  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([schoolId])
  @@index([authorId])
}

// ── MasterTask ─────────────────────────────────────────────

model MasterTask {
  id           String   @id @default(cuid())
  title        String
  description  String?
  subject      String?
  dueAt        DateTime?
  // Buchseiten / Material
  bookName     String?
  bookPageFrom Int?
  bookPageTo   Int?
  exerciseNr   String?  // z.B. "3a, 3b, 4"
  teacherId    String
  classId      String
  schoolId     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  files      MasterTaskFile[]
  progress   MasterTaskProgress[]

  @@index([classId])
  @@index([teacherId])
  @@index([schoolId])
}

model MasterTaskFile {
  id        String   @id @default(cuid())
  taskId    String
  task      MasterTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  name      String
  path      String
  mimeType  String
  size      Int
  createdAt DateTime @default(now())

  @@index([taskId])
}

model MasterTaskProgress {
  id             String     @id @default(cuid())
  taskId         String
  task           MasterTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  studentId      String
  status         String     @default("todo") // todo | in_progress | done
  comment        String?
  submissionPath String?
  submissionName String?
  updatedAt      DateTime   @updatedAt

  @@unique([taskId, studentId])
  @@index([studentId])
  @@index([taskId])
}
